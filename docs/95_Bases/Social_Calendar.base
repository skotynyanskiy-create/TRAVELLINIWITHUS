filters:
  and:
    - 'file.ext == "md"'
    - 'type == "social-post"'
properties:
  file.name:
    displayName: Contenuto
  status:
    displayName: Stato
  channel:
    displayName: Canale
  format:
    displayName: Formato
  destination:
    displayName: Destinazione
  pillar:
    displayName: Pilastro
  publish_date:
    displayName: Pubblicazione
  caption_ready:
    displayName: Caption pronta
views:
  - type: table
    name: Prossima settimana
    filters:
      and:
        - 'publish_date && date(publish_date) >= today()'
        - 'publish_date && date(publish_date) < today() + "7d"'
    order:
      - publish_date
      - file.name
      - status
      - channel
      - format
      - destination
      - pillar
      - caption_ready
  - type: table
    name: In produzione
    filters:
      or:
        - 'status == "idea"'
        - 'status == "in-produzione"'
        - 'status == "review"'
    order:
      - file.name
      - status
      - channel
      - format
      - destination
      - pillar
      - publish_date
  - type: table
    name: Per canale
    order:
      - channel
      - file.name
      - format
      - status
      - publish_date
      - destination
