filters:
  and:
    - 'file.ext == "md"'
    - or:
      - 'type == "partner"'
      - 'type == "collaboration"'
properties:
  file.name:
    displayName: Partner
  type:
    displayName: Type
  company:
    displayName: Company
  status:
    displayName: Status
  stage:
    displayName: Stage
  offer_type:
    displayName: Offer
  owner:
    displayName: Owner
  priority:
    displayName: Priority
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Partner Pipeline
    filters:
      and:
        - 'status != "done"'
        - 'status != "conclusa"'
        - 'status != "rifiutata"'
    order:
      - status
      - stage
      - priority
      - file.mtime
