filters:
  and:
    - 'file.ext == "md"'
    - 'type == "seo-page"'
properties:
  file.name:
    displayName: Pagina
  status:
    displayName: Stato
  priority:
    displayName: Priorità
  route:
    displayName: Route
  keyword_primaria:
    displayName: Keyword primaria
  score:
    displayName: Score
  last_audit:
    displayName: Ultimo audit
views:
  - type: table
    name: Da ottimizzare
    filters:
      or:
        - 'status == "da-ottimizzare"'
        - 'status == "in-corso"'
    order:
      - file.name
      - status
      - priority
      - route
      - keyword_primaria
      - score
      - last_audit
  - type: table
    name: Tutte le pagine
    order:
      - file.name
      - status
      - priority
      - route
      - keyword_primaria
      - score
      - last_audit
  - type: table
    name: Ottimizzate
    filters:
      and:
        - 'status == "ottimizzato"'
    order:
      - file.name
      - route
      - keyword_primaria
      - score
      - last_audit
