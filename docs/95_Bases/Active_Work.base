filters:
  and:
    - 'file.ext == "md"'
    - or:
      - 'type == "project"'
      - 'type == "task"'
      - 'type == "bug"'
      - 'type == "ui-change"'
      - 'type == "content-brief"'
      - 'type == "campaign"'
      - 'type == "partner"'
      - 'type == "collaboration"'
properties:
  file.name:
    displayName: Note
  type:
    displayName: Type
  status:
    displayName: Status
  priority:
    displayName: Priority
  area:
    displayName: Area
  owner:
    displayName: Owner
  due:
    displayName: Due
  route:
    displayName: Route
  repo_path:
    displayName: Repo Path
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Open Work
    filters:
      or:
        - 'status == "open"'
        - 'status == "in-progress"'
        - 'status == "blocked"'
        - 'status == "active"'
        - 'status == "planned"'
        - 'status == "lead"'
        - 'status == "proposta"'
        - 'status == "negoziazione"'
    order:
      - status
      - priority
      - due
      - file.mtime
