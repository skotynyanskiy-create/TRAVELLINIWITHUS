filters:
  and:
    - 'file.ext == "md"'
    - 'type == "place"'
properties:
  file.name:
    displayName: Luogo
  category:
    displayName: Categoria
  status:
    displayName: Stato
  destination:
    displayName: Destinazione
  country:
    displayName: Paese
  rating:
    displayName: Rating
  price_range:
    displayName: Prezzo
  affiliate_link:
    displayName: Affiliate
views:
  - type: table
    name: Tutti i luoghi
    order:
      - file.name
      - category
      - status
      - destination
      - country
      - rating
      - price_range
      - affiliate_link
  - type: table
    name: Per destinazione
    order:
      - destination
      - file.name
      - category
      - rating
      - price_range
      - status
  - type: table
    name: Hotel
    filters:
      and:
        - 'category == "hotel"'
    order:
      - file.name
      - destination
      - country
      - rating
      - price_range
      - affiliate_link
      - status
  - type: table
    name: Da visitare
    filters:
      and:
        - 'status == "da-visitare"'
    order:
      - file.name
      - category
      - destination
      - country
      - rating
