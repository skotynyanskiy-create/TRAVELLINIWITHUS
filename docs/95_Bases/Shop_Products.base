filters:
  and:
    - 'file.ext == "md"'
    - 'type == "product"'
properties:
  file.name:
    displayName: Prodotto
  status:
    displayName: Stato
  category:
    displayName: Categoria
  price:
    displayName: Prezzo
  route:
    displayName: Route
  affiliate:
    displayName: Affiliate
views:
  - type: table
    name: Tutti i prodotti
    order:
      - file.name
      - status
      - category
      - price
      - route
      - affiliate
  - type: table
    name: Live
    filters:
      and:
        - 'status == "live"'
    order:
      - file.name
      - category
      - price
      - route
      - affiliate
  - type: table
    name: In sviluppo
    filters:
      or:
        - 'status == "idea"'
        - 'status == "in-sviluppo"'
    order:
      - file.name
      - status
      - category
      - price
