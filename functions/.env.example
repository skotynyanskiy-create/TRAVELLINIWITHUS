# Firebase Functions — configurazione non sensibile per un progetto Firebase.
#
# Copia questo file in functions/.env.<project-id> prima del primo deploy,
# oppure lascia che Firebase CLI lo generi quando chiede i parametri dichiarati
# in src/index.ts. I file .env.<project-id> sono ignorati da Git.
#
# I segreti (Stripe, Resend, Brevo, OpenAI, Anthropic, Gemini) stanno soltanto
# in Firebase Secret Manager: non inserirli qui.

# URL pubblico e canonico, usato per callback Stripe e link email.
APP_URL=https://travelliniwithus.it

# Obbligatorio: il database Firestore del progetto non si chiama "(default)".
FIRESTORE_DATABASE_ID=

# Opzionali: mantengono i default del codice se lasciati vuoti.
MAIL_TO_OWNER=hello@travelliniwithus.it
MAIL_FROM="Travelliniwithus <hello@travelliniwithus.it>"
MEDIA_KIT_URL=
LEAD_MAGNET_URL=
BREVO_LIST_ID=
AI_COMPANION_CORPUS_READY=false
