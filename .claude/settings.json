      "Bash(git restore * firestore.rules)",
      "Bash(* > firestore.rules)",
      "Bash(* >> firestore.rules)",
      "Bash(tee firestore.rules*)",
      "Bash(cp * src/config/admin.ts)",
      "Bash(mv * src/config/admin.ts)",
      "Bash(git checkout * src/config/admin.ts)",
      "Bash(git restore * src/config/admin.ts)",
      "Bash(* > src/config/admin.ts)",
      "Bash(* >> src/config/admin.ts)",
      "Bash(tee src/config/admin.ts*)",
