{
  "name": "travelliniwithus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node scripts/start-prod.mjs",
    "generate:media-kit": "tsx scripts/generate-media-kit.tsx",
    "generate:lead-magnet": "tsx scripts/generate-lead-magnet.tsx",
    "generate:og": "tsx scripts/generate-og-images.mjs",
    "generate:obsidian-index": "node scripts/generate-obsidian-index.mjs",
    "publish:article": "tsx scripts/publish-article-seed.mjs",
    "graphify:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-graphify.ps1",
    "graphify:index": ".tools\\graphify\\Scripts\\graphify.exe update . --force",
    "graphify:watch": ".tools\\graphify\\Scripts\\graphify.exe watch .",
    "graphify:check": ".tools\\graphify\\Scripts\\graphify.exe check-update .",
    "graphify:query": ".tools\\graphify\\Scripts\\graphify.exe query",
    "graphify:affected": ".tools\\graphify\\Scripts\\graphify.exe affected",
    "graphify:explain": ".tools\\graphify\\Scripts\\graphify.exe explain",
    "graphify:path": ".tools\\graphify\\Scripts\\graphify.exe path",
    "graphify:benchmark": ".tools\\graphify\\Scripts\\graphify.exe benchmark",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prepare:reels": "node scripts/convert-reels.js",
    "ingest:doc": "py -3 scripts/ingest-doc.py",
    "build": "npm run generate:media-kit && npm run generate:lead-magnet && npm run generate:og && npm run optimize:images && tsx scripts/generate-sitemap.js && vite build && tsx scripts/generate-route-html.js",
    "functions:build": "npm --prefix functions run build",
    "functions:smoke": "node scripts/check-functions-smoke.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:hooks": "py scripts/hooks/test_hooks.py",
    "e2e": "playwright test",
    "test:e2e": "npm run e2e",
    "audit:ui": "node scripts/check-ui.mjs",
    "audit:provenance": "node scripts/check-image-provenance.mjs",
    "audit:firebase": "node scripts/check-firebase.mjs",
    "audit:stripe": "node scripts/check-stripe.mjs",
    "audit:revenue": "node scripts/check-revenue-security.mjs",
    "audit:agents": "node scripts/audit-agent-stack.mjs",
    "audit:ai-seo": "node scripts/check-ai-seo.mjs",
    "check:graphify": "node scripts/check-graphify.mjs",
    "audit:obsidian": "node scripts/audit-obsidian.mjs",
    "audit:env": "node scripts/check-env-safety.mjs",
    "audit:visual": "playwright test e2e/visual-quality.spec.ts",
    "audit:public-footprint": "node scripts/check-public-footprint.mjs",
    "audit:quality": "npm run typecheck && npm run lint && npm run format:check && npm run lint:md:core && npm run test && npm run build && npm run audit:seed && npm run audit:ui && npm run audit:provenance && npm run audit:llms && npm run audit:env && npm run audit:public-footprint && npm run audit:firebase && npm run audit:stripe && npm run audit:revenue && npm run audit:agents && npm run audit:obsidian && npm run stato:check && npm run audit:visual && npm run audit:size",
    "audit:all": "npm run audit:ui && npm run audit:firebase && npm run audit:stripe",
    "audit:cwv": "npm run build && npx --yes @lhci/cli@0.14.x autorun --config=./lighthouserc.json",
    "audit:bulk": "npx --yes unlighthouse@0 --site http://localhost:3000 --output-path .audit-screenshots/unlighthouse",
    "audit:a11y": "node scripts/check-a11y.mjs",
    "audit:api-live": "node scripts/check-api-live.mjs",
    "audit:secrets": "gitleaks detect --source . --no-banner --redact",
    "audit:secrets:history": "gitleaks detect --source . --no-banner --redact",
    "audit:secrets:staged": "gitleaks protect --staged --no-banner --redact",
    "audit:secrets:local": "gitleaks detect --source . --no-git --no-banner --redact",
    "audit:size": "node scripts/check-size.mjs",
    "audit:bundle:viz": "npx --yes vite-bundle-visualizer@1 -o .audit-screenshots/bundle.html",
    "audit:deps": "knip --no-progress",
    "analyze": "analyze",
    "lint:md": "npx --yes markdownlint-cli2@0 \"docs/**/*.md\" \"*.md\"",
    "webhook:listen": "stripe listen --forward-to localhost:3000/api/webhook",
    "emulators": "firebase emulators:start --only firestore,auth",
    "release:sentry": "npx --yes @sentry/cli@2 releases new $npm_package_version && npx --yes @sentry/cli@2 sourcemaps upload --release=$npm_package_version dist/assets && npx --yes @sentry/cli@2 releases finalize $npm_package_version",
    "sync:agents": "node scripts/sync-agent-skills.mjs",
    "eval:skills": "node scripts/eval-skills.mjs",
    "sync:codex-agents": "node scripts/sync-codex-agents.mjs",
    "setup:obsidian-plugins": "node scripts/install-obsidian-plugins.mjs",
    "sync:obsidian": "node scripts/sync-obsidian-vault.mjs",
    "geocode:content": "node scripts/geocode-content.mjs",
    "import:instagram": "tsx scripts/import-instagram.ts",
    "scaffold:page": "node scripts/scaffold-page.mjs",
    "predeploy": "node scripts/predeploy.mjs",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:route-html": "tsx scripts/generate-route-html.js",
    "stato": "tsx scripts/stato.mjs",
    "stato:check": "tsx scripts/stato.mjs --check",
    "generate:llms": "node scripts/generate-llms-index.mjs",
    "audit:llms": "node scripts/generate-llms-index.mjs --check",
    "verdetti:scheda": "node scripts/generate-verdetti-sheet.mjs",
    "verdetti:applica": "node scripts/apply-verdetti-sheet.mjs",
    "audit:seed": "node scripts/check-content-seed.mjs",
    "lint:md:core": "npx --yes markdownlint-cli2@0 \"CLAUDE.md\" \"AGENTS.md\" \"README.md\" \".claude/rules/*.md\""
  },
