{
  "name": "travelliniwithus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node server.ts",
    "generate:media-kit": "tsx scripts/generate-media-kit.tsx",
    "generate:lead-magnet": "tsx scripts/generate-lead-magnet.tsx",
    "generate:og": "node scripts/generate-og-images.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prepare:reels": "node scripts/convert-reels.js",
    "build": "npm run generate:media-kit && npm run generate:lead-magnet && npm run generate:og && npm run optimize:images && node scripts/generate-sitemap.js && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit:ui": "node scripts/check-ui.mjs",
    "audit:firebase": "node scripts/check-firebase.mjs",
    "audit:stripe": "node scripts/check-stripe.mjs",
    "audit:revenue": "node scripts/check-revenue-security.mjs",
    "audit:agents": "node scripts/audit-agent-stack.mjs",
    "audit:visual": "playwright test e2e/visual-quality.spec.ts",
    "audit:quality": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:ui && npm run audit:firebase && npm run audit:stripe && npm run audit:revenue && npm run audit:agents && npm run audit:visual && npm run audit:size",
    "audit:all": "npm run audit:ui && npm run audit:firebase && npm run audit:stripe",
    "audit:cwv": "npm run build && npx --yes @lhci/cli@0.14.x autorun --config=./lighthouserc.json",
    "audit:bulk": "npx --yes unlighthouse@latest --site http://localhost:3000 --output-path .audit-screenshots/unlighthouse",
    "audit:a11y": "npx --yes @axe-core/cli@latest http://localhost:3000 http://localhost:3000/collaborazioni http://localhost:3000/media-kit http://localhost:3000/chi-siamo --tags wcag2a,wcag2aa,wcag21aa",
    "audit:secrets": "gitleaks detect --source . --no-banner --redact",
    "audit:size": "node scripts/check-size.mjs",
    "audit:bundle:viz": "npx --yes vite-bundle-visualizer@latest -o .audit-screenshots/bundle.html",
    "audit:deps": "npx --yes knip@latest --no-progress",
    "lint:md": "npx --yes markdownlint-cli2@latest \"docs/**/*.md\" \"*.md\"",
    "webhook:listen": "stripe listen --forward-to localhost:3000/api/webhook",
    "emulators": "firebase emulators:start --only firestore,auth",
    "release:sentry": "npx --yes @sentry/cli@latest releases new $npm_package_version && npx --yes @sentry/cli@latest sourcemaps upload --release=$npm_package_version dist/assets && npx --yes @sentry/cli@latest releases finalize $npm_package_version",
    "sync:agents": "node scripts/sync-agent-skills.mjs",
    "scaffold:page": "node scripts/scaffold-page.mjs",
    "predeploy": "node scripts/predeploy.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@gsap/react": "^2.1.2",
    "@react-pdf/renderer": "^4.3.1",
    "@sentry/react": "^10.53.1",
    "@stripe/stripe-js": "^8.10.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.21",
    "@types/mapbox-gl": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "fuse.js": "^7.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.20.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-helmet-async": "^3.0.0",
    "react-intersection-observer": "^10.0.3",
    "react-is": "^19.2.4",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.13.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.4.1",
    "vite": "^6.2.0",
    "web-vitals": "^5.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0",
    "*.{ts,tsx,css,md,json}": "prettier --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-simple-maps": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "node-cache": "^5.1.2",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "workbox-window": "^7.4.0"
  }
}
