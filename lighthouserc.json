{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/lhci-preview.mjs",
      "startServerReadyPattern": "LHCI_READY",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4173/?twu_audit=1",
        "http://localhost:4173/esplora?twu_audit=1",
        "http://localhost:4173/chi-siamo?twu_audit=1",
        "http://localhost:4173/collaborazioni?twu_audit=1",
        "http://localhost:4173/media-kit?twu_audit=1",
        "http://localhost:4173/shop?twu_audit=1"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "uses-text-compression": "off",
        "csp-xss": "off",
        "is-on-https": "off",
        "redirects-http": "off",
        "uses-http2": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
