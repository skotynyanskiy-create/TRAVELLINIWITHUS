# ============================================================
# TRAVELLINIWITHUS — Variabili d'ambiente
# ============================================================
# Copia in `.env` e inserisci i valori reali solo in fase pre-deploy.
# Questo file È committato — non inserire mai valori reali qui.
#
# Regola operativa (da memoria progetto):
#   Il codice è scritto con guard clause: ogni integrazione
#   si auto-disabilita silenziosamente se la chiave manca.
#   Il sito funziona anche con zero chiavi configurate.
# ============================================================

# --- APP ---
# Locale: http://localhost:3000 | Prod: https://travelliniwithus.it
APP_URL=http://localhost:3000

# --- LITE MODE ---
# true = pubblicazione lite: nasconde rotte/link/sitemap per Esplora, Itinerari,
# Shop, Club, Preferiti + spegne AiAssistant e ExitIntentPopup. Quando una di
# Full-mode pubblico: tutte le sezioni editoriali e funnel sono navigabili.
# Per tornare a un sito ridotto/staging: set VITE_LITE_MODE=true + rebuild.
VITE_LITE_MODE=false
# Override opzionale del link PDF inviato per il media kit.
# Se vuoto, usa APP_URL/media-kit.pdf in locale e travelliniwithus.it/media-kit.pdf in fallback.
MEDIA_KIT_URL=
# Override opzionale del link PDF inviato per il lead magnet.
# Se vuoto, usa APP_URL/lead-magnet-posti-italiani.pdf.
LEAD_MAGNET_URL=
# Email mittente transazionale (verificato su Resend)
MAIL_FROM="Travelliniwithus <hello@travelliniwithus.it>"
# Email destinataria lead interna
MAIL_TO_OWNER=hello@travelliniwithus.it

# --- STRIPE ---
# Dashboard: https://dashboard.stripe.com/apikeys
# Test mode per sviluppo, live solo in prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID del piano Club ricorrente (creato in Stripe)
STRIPE_CLUB_PRICE_ID=

# --- RESEND (email transazionale) ---
# Dashboard: https://resend.com/api-keys
# Domain verification richiesta: https://resend.com/domains
RESEND_API_KEY=

# --- BREVO (newsletter + audience) ---
# Dashboard: https://app.brevo.com/settings/keys/api
# Lista DOI ID (crea prima la lista in Brevo)
BREVO_API_KEY=
BREVO_LIST_ID=

# --- OPENAI (AI semantic search) ---
# Dashboard: https://platform.openai.com/api-keys
# Modello scelto: text-embedding-3-small (~$0.02/1M token)
OPENAI_API_KEY=

# --- ANTHROPIC (AI companion server-side) ---
# Usata solo lato server. Non usare mai prefisso VITE_ per questa chiave.
ANTHROPIC_API_KEY=
# true solo quando corpus/vector store sono pronti.
AI_COMPANION_CORPUS_READY=false

# --- SENTRY (error tracking + web-vitals) ---
# Dashboard: https://sentry.io/settings/projects/
# DSN separati client/server consigliato. Vuoto = telemetry disattivata.
# Web Vitals (CLS/INP/LCP/FCP/TTFB) sono comunque inoltrate a gtag/dataLayer
# se window.gtag o window.dataLayer sono disponibili.
VITE_SENTRY_DSN=
SENTRY_DSN=
# Opzionale: identifica la release Sentry (es. git sha o version)
VITE_APP_VERSION=

# --- ANALYTICS / PIXEL ---
# GA4: https://analytics.google.com/
VITE_GA_ID=
# Meta Pixel: https://business.facebook.com/events_manager
VITE_META_PIXEL_ID=
# TikTok Pixel: https://ads.tiktok.com/i18n/events_manager
VITE_TIKTOK_PIXEL_ID=

# --- AFFILIATE IDS ---
VITE_AFFILIATE_SKYSCANNER_ID=
VITE_AFFILIATE_BOOKING_ID=
VITE_AFFILIATE_AIRALO_ID=
VITE_AFFILIATE_REVOLUT_ID=

# --- MAPBOX ---
# Dashboard: https://account.mapbox.com/access-tokens
VITE_MAPBOX_TOKEN=

# --- FIREBASE CLIENT ---
# Firebase Web API key. Non committare il valore reale in JSON o docs.
# Dashboard: Firebase/GCP project settings oppure APIs & Services → Credentials.
VITE_FIREBASE_API_KEY=
# Solo sviluppo locale con emulatori Firebase.
VITE_USE_FIREBASE_EMULATOR=false
# Opzionale: App Check / reCAPTCHA Enterprise se attivato.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- FIREBASE ADMIN / SERVICE ACCOUNT ---
# Solo server-side. Preferire secret manager/hosting env in produzione.
# Non committare mai JSON reali, service account o chiavi private.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT=

# --- GEMINI AI (legacy, valutare se dismettere) ---
# Dashboard: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- DEV FLAGS ---
# true in locale per bypassare Stripe con checkout mock
ALLOW_MOCK_CHECKOUT=true
# true solo per audit visuali/locali espliciti.
VITE_TWU_AUDIT_MODE=false

# --- ADMIN ---
# Email admin server-side fallback. Allineare con src/config/admin.ts e regole Firestore.
ADMIN_EMAIL=

# ============================================================
# MCP SERVERS — credenziali per `.mcp.json`
# ============================================================
# Queste variabili NON sono usate dal sito web. Servono solo
# agli MCP server di Claude Code (stripe, sentry, github).
# Claude Code legge dall'environment Windows user, non da .env.
#
# Per attivarle in Windows (una sola volta, in PowerShell):
#   [Environment]::SetEnvironmentVariable('STRIPE_SECRET_KEY','sk_...','User')
#   [Environment]::SetEnvironmentVariable('SENTRY_AUTH_TOKEN','...','User')
#   [Environment]::SetEnvironmentVariable('SENTRY_ORG','travelliniwithus','User')
#   [Environment]::SetEnvironmentVariable('GITHUB_PERSONAL_ACCESS_TOKEN','ghp_...','User')
# Poi riapri VSCode/Claude Code.
#
# - STRIPE_SECRET_KEY: la stessa di sopra, ma esportata come env user.
# - SENTRY_AUTH_TOKEN: https://sentry.io/settings/account/api/auth-tokens/
#                     scope minimi: project:read, event:read.
# - SENTRY_ORG: slug org Sentry (es. travelliniwithus).
# - GITHUB_PERSONAL_ACCESS_TOKEN: https://github.com/settings/tokens
#                                 scope: repo (lettura) + read:org.
# ============================================================
OBSIDIAN_API_KEY=
SENTRY_ACCESS_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
GITHUB_PERSONAL_ACCESS_TOKEN=
